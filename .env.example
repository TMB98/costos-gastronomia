# Copiá este archivo a ".env" (sin el ".example") y completá con los valores
# reales de tu proyecto de Supabase — Settings > API en el dashboard.
#
# El archivo ".env" real NUNCA se sube al repositorio (está en .gitignore).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aca

# Opcional — sin esto, la app funciona igual pero no reporta errores a
# ningún lado. El DSN de Sentry NO es secreto (termina viajando igual en el
# código que corre en el navegador), sacalo de sentry.io → tu proyecto →
# Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
